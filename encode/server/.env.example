PORT=3000

# Pilihan: folder simpanan fail & queue (lalai: ./data). Guna folder lain untuk ujian.
# DATA_DIR=

# Kunci rahsia antara PC (agent) dan droplet. Jana: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_KEY=tukar-ini

# Password ringkas untuk halaman upload (sepanjang testing). Kosongkan = tiada password.
UPLOAD_PASSWORD=tukar-ini

# Had saiz upload (MB)
MAX_UPLOAD_MB=100

# Padam fail & job lama selepas N minit
RETENTION_MINUTES=60

# Job "processing" yang agent tak siapkan dalam N minit dikembalikan ke queue
# (premium lambat, jadi jangan letak terlalu kecil)
PROCESSING_TIMEOUT_MINUTES=30
