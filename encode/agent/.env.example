# URL droplet (tanpa slash di hujung)
SERVER_URL=http://139.59.234.240:3000

# Mesti sama dengan AGENT_KEY di droplet
AGENT_KEY=tukar-ini

# Laluan ffmpeg untuk Standard. Guna build dalam vendor/ (NVENC jalan dengan driver 595+):
FFMPEG_PATH=vendor/ffmpeg/bin/ffmpeg.exe

# ---- Premium (AI, lihat README bahagian Premium) ----
# max      = short side 2160 (4K-class), 120fps, input AI hingga 720p   (paling lambat)
# balanced = short side 1440, 60fps, input AI hingga 540p              (~3-4x lebih cepat)
PREMIUM_PROFILE=max
# Folder kerja sementara (SSD laju, perlu beberapa GB). Dipadam selepas berjaya.
PREMIUM_WORK_DIR=D:/encode-work/jobs
# auto|live|anime  (auto = live-action; anime guna model anime Video2X)
PREMIUM_CONTENT=auto
# hevc (NVENC 10-bit, laju) | av1 (SVT-AV1 perisian; RTX 20-series tiada AV1 encoder, sangat lambat)
PREMIUM_CODEC=hevc
# Skor VMAF minimum berbanding master; calon terkecil yang lulus dipilih
PREMIUM_VMAF_MIN=95
# rife-v4.26 | rife-v4.25 | rife-v4.25-lite | rife-v4.6
PREMIUM_RIFE_MODEL=rife-v4.26
# Simpan fail perantaraan untuk debug (1 = ya)
PREMIUM_KEEP_TEMP=0

# auto = cuba NVENC (GPU) dulu, jatuh ke libx264 (CPU) kalau gagal. Atau: nvenc | cpu
ENCODER=auto

# Had tempoh output (saat). Status WhatsApp ~30s.
MAX_SECONDS=30

# Tinggi maksimum output (px). 1280 = 720p portrait. 0 = jangan ubah saiz.
MAX_HEIGHT=1280

# Kualiti: nvenc -cq / x264 -crf. Lebih kecil = lebih bagus tapi fail lebih besar.
QUALITY=23

# Bitrate maksimum (WhatsApp mampat semula, jadi jangan terlalu tinggi)
MAX_BITRATE=4M

# Selang poll bila tiada job (ms)
POLL_MS=3000
