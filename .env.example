PORT=3000
VERIFY_TOKEN=tukar-token-ini
# Dari Meta App Dashboard > Settings > Basic (untuk sahkan tandatangan webhook)
APP_SECRET=
# Permanent System User token (whatsapp_business_messaging)
WHATSAPP_TOKEN=
# Phone number ID (bukan nombor telefon)
PHONE_NUMBER_ID=
GRAPH_VERSION=v21.0
# Had saiz video untuk diproses (bait). WhatsApp had ~16MB
MAX_INPUT_BYTES=16000000
